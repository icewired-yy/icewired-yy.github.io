{% assign gallery_published = site.gallery | where: 'published', true %}
{% assign gallery_home_wide = gallery_published | where: 'home_slot', 'wide' | first %}
{% assign gallery_home_tall = gallery_published | where: 'home_slot', 'tall' | first %}
{% assign gallery_home_small = gallery_published | where: 'home_slot', 'small' | first %}
{% assign gallery_home_long = gallery_published | where: 'home_slot', 'long' | first %}
{% if gallery_home_wide and gallery_home_tall and gallery_home_small and gallery_home_long %}
  <section class="gallery-home-preview" aria-labelledby="gallery-home-title">
    <div class="gallery-home-preview__heading">
      <h2 id="gallery-home-title">Life, recently</h2>
      <p>A quieter record beside the research.</p>
    </div>

    <div class="photo-rhythm" aria-label="Recent photographs">
      {% include figure.liquid path=gallery_home_wide.image alt=gallery_home_wide.alt width=gallery_home_wide.width height=gallery_home_wide.height figure_class='photo-wide' sizes='(min-width: 701px) 56vw, 96vw' loading='lazy' decoding='async' %}
      {% include figure.liquid path=gallery_home_tall.image alt=gallery_home_tall.alt width=gallery_home_tall.width height=gallery_home_tall.height figure_class='photo-tall' sizes='(min-width: 701px) 31vw, 48vw' loading='lazy' decoding='async' %}
      {% include figure.liquid path=gallery_home_small.image alt=gallery_home_small.alt width=gallery_home_small.width height=gallery_home_small.height figure_class='photo-small' sizes='(min-width: 701px) 31vw, 48vw' loading='lazy' decoding='async' %}
      {% include figure.liquid path=gallery_home_long.image alt=gallery_home_long.alt width=gallery_home_long.width height=gallery_home_long.height figure_class='photo-long' sizes='(min-width: 701px) 40vw, 48vw' loading='lazy' decoding='async' %}
    </div>

    <p class="gallery-home-preview__link">
      <a href="{{ '/gallery/' | relative_url }}">
        Enter the gallery
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M4 12 12 4M6 4h6v6"></path>
        </svg>
      </a>
    </p>
  </section>
{% endif %}
