{% comment %}
  Render the existing News collection as one calm chronology. Passing any
  truthy `limit` value applies `site.announcements.limit`; omitting it renders
  the complete archive. The collection remains the sole content authority.
{% endcomment %}
{% if site.news != blank %}
  {% assign contemplative_news = site.news | reverse %}
  {% assign contemplative_news_limit = site.news | size %}
  {% if include.limit and site.announcements.limit %}
    {% assign contemplative_news_limit = site.announcements.limit %}
  {% endif %}
  <ol class="contemplative-news-list" aria-label="News in reverse chronological order">
    {% for item in contemplative_news limit: contemplative_news_limit %}
      <li class="news-entry">
        <time class="news-entry__date" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
        <div class="news-entry__body">
          {% if item.inline %}
            {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
          {% else %}
            <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title | escape }}</a>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ol>
{% else %}
  <p class="collection-empty">No news has been published yet.</p>
{% endif %}
