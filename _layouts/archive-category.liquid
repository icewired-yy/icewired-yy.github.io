---
layout: default
---
<div class="post contemplative-notes notes-archive">
  <header class="notes-archive-header">
    <nav class="notes-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ '/blog/' | relative_url }}">Notes</a>
      <span aria-hidden="true">/</span>
      <span>Category</span>
    </nav>
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">Notes gathered under this category.</p>
  </header>

  <section aria-labelledby="archive-notes-title">
    <h2 id="archive-notes-title" class="sr-only">Archived notes</h2>
    <ol class="notes-archive-list">
      {% for post in page.posts %}
        <li>
          <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%b %d, %Y' }}</time>
          <div>
            {% if post.redirect == blank %}
              <a class="post-link" href="{{ post.url | relative_url }}">{{ post.title }}</a>
            {% elsif post.redirect contains '://' %}
              <a class="post-link" href="{{ post.redirect }}" target="_blank" rel="external nofollow noopener">{{ post.title }}</a>
            {% else %}
              <a class="post-link" href="{{ post.redirect | relative_url }}">{{ post.title }}</a>
            {% endif %}
            {% if post.description %}<p>{{ post.description }}</p>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  </section>
</div>
