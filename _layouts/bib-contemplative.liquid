---
---
{% comment %}
  Render one Jekyll Scholar record as a contemplative work row. The template
  keeps bibliography data authoritative: previews, author order, abstracts,
  venue metadata, and resource links all come directly from the BibTeX entry.
{% endcomment %}

{% comment %}Resolve a stable primary destination for the image and title.{% endcomment %}
{% assign primary_url = entry.website %}
{% if primary_url == blank and entry.url %}
  {% assign primary_url = entry.url %}
{% endif %}
{% if primary_url == blank and entry.doi %}
  {% assign primary_url = entry.doi %}
  {% unless primary_url contains '://' %}
    {% assign primary_url = primary_url | prepend: 'https://doi.org/' %}
  {% endunless %}
{% endif %}
{% if primary_url == blank and entry.html %}
  {% assign primary_url = entry.html %}
  {% unless primary_url contains '://' %}
    {% assign primary_url = primary_url | prepend: '/assets/html/' | relative_url %}
  {% endunless %}
{% endif %}
{% if primary_url == blank and entry.pdf %}
  {% assign primary_url = entry.pdf %}
  {% unless primary_url contains '://' %}
    {% assign primary_url = primary_url | prepend: '/assets/pdf/' | relative_url %}
  {% endunless %}
{% endif %}

{% comment %}Prefer concise series metadata, then fall back to standard BibTeX venue fields.{% endcomment %}
{% assign publication_venue = entry.series %}
{% if publication_venue == blank %}
  {% if entry.type == 'article' %}
    {% assign publication_venue = entry.journal %}
  {% elsif entry.type == 'inproceedings' or entry.type == 'incollection' %}
    {% assign publication_venue = entry.booktitle %}
  {% elsif entry.type == 'thesis' or entry.type == 'mastersthesis' or entry.type == 'phdthesis' %}
    {% assign publication_venue = entry.school %}
  {% elsif entry.publisher %}
    {% assign publication_venue = entry.publisher %}
  {% endif %}
{% endif %}

{% comment %}Normalize the optional preview without producing a broken image for incomplete records.{% endcomment %}
{% assign preview_path = entry.preview %}
{% if preview_path and preview_path != blank %}
  {% unless preview_path contains '://' %}
    {% assign preview_path = preview_path | prepend: '/assets/img/publication_preview/' | relative_url %}
  {% endunless %}
{% endif %}

<article
  id="{{ entry.key | escape }}"
  class="work-item research-item publication-entry{% if preview_path == blank %} work-item-no-image{% endif %}"
  data-publication-key="{{ entry.key | escape }}"
>
  {% if preview_path and preview_path != blank %}
    {% if primary_url and primary_url != blank %}
      <a
        class="work-image work-media"
        href="{{ primary_url }}"
        target="_blank"
        rel="external noopener noreferrer"
        aria-label="Open the project materials for {{ entry.title | strip_html | escape }}"
      >
        <img
          src="{{ preview_path }}"
          alt="Preview for {{ entry.title | strip_html | escape }}"
          loading="lazy"
          decoding="async"
        >
      </a>
    {% else %}
      <div class="work-image work-media">
        <img
          src="{{ preview_path }}"
          alt="Preview for {{ entry.title | strip_html | escape }}"
          loading="lazy"
          decoding="async"
        >
      </div>
    {% endif %}
  {% else %}
    <div class="work-image work-media work-image-placeholder" aria-hidden="true">
      <span>{{ entry.year | default: 'Research' }}</span>
    </div>
  {% endif %}

  <div class="work-content work-copy">
    <p class="work-meta">
      {% if entry.year %}<span class="work-index">{{ entry.year }}</span>{% endif %}
      {% if entry.year and publication_venue != blank %}<span aria-hidden="true"> · </span>{% endif %}
      {% if publication_venue != blank %}<span>{{ publication_venue }}</span>{% endif %}
    </p>

    <h3>
      {% if primary_url and primary_url != blank %}
        <a href="{{ primary_url }}" target="_blank" rel="external noopener noreferrer">{{ entry.title }}</a>
      {% else %}
        {{ entry.title }}
      {% endif %}
    </h3>

    <div class="work-detail publication-detail">
      <div class="work-detail-inner">
        {% comment %}Render every author in source order and retain al-folio self/coauthor semantics.{% endcomment %}
        {% if entry.author_array and entry.author_array.size > 0 %}
          <p class="work-authors">
            {%- for author in entry.author_array -%}
              {% assign author_is_self = false %}
              {% assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' %}
              {% assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' %}
              {% if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first %}
                {% assign author_is_self = true %}
              {% endif %}

              {% assign coauthor_url = null %}
              {% assign clean_last_name = author_last_name | downcase | remove_accents %}
              {% if site.data.coauthors[clean_last_name] %}
                {% for coauthor in site.data.coauthors[clean_last_name] %}
                  {% if coauthor.firstname contains author.first %}
                    {% assign coauthor_url = coauthor.url %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}

              {%- if author_is_self -%}
                <strong>{{ author.first }} {{ author_last_html }}</strong>
              {%- elsif coauthor_url -%}
                <a href="{{ coauthor_url }}">{{ author.first }} {{ author_last_html }}</a>
              {%- else -%}
                {{ author.first }} {{ author_last_html }}
              {%- endif -%}
              {%- unless forloop.last -%}
                {%- if forloop.length == 2 %} and {% elsif forloop.rindex == 2 %}, and {% else %}, {% endif -%}
              {%- endunless -%}
            {%- endfor -%}
          </p>
        {% endif %}

        {% if entry.abstract %}
          <p class="work-summary">
            {% if page.home_surface %}
              {{ entry.abstract | truncatewords: 46 }}
            {% else %}
              {{ entry.abstract }}
            {% endif %}
          </p>
        {% endif %}
        {% if entry.note %}
          <p class="work-note">{{ entry.note | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% endif %}
        {% if entry.additional_info %}
          <p class="work-note">{{ entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% endif %}
        {% if entry.award %}
          <p class="work-award">{{ entry.award | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% endif %}

        {% comment %}Expose each supported al-folio resource field as a real destination.{% endcomment %}
        {% assign doi_url = entry.doi %}
        {% if doi_url and doi_url != blank %}
          {% unless doi_url contains '://' %}
            {% assign doi_url = doi_url | prepend: 'https://doi.org/' %}
          {% endunless %}
        {% endif %}
        <div class="work-links entry-links" aria-label="Resources for {{ entry.title | strip_html | escape }}">
          {% if entry.website %}
            <a class="text-link" href="{{ entry.website }}" target="_blank" rel="external noopener noreferrer">Project page</a>
          {% endif %}
          {% if doi_url and doi_url != blank %}
            <a class="text-link" href="{{ doi_url }}" target="_blank" rel="external noopener noreferrer">DOI</a>
          {% endif %}
          {% if entry.url and entry.url != doi_url and entry.url != entry.website %}
            <a class="text-link" href="{{ entry.url }}" target="_blank" rel="external noopener noreferrer">Publisher</a>
          {% endif %}
          {% if entry.arxiv %}
            <a class="text-link" href="https://arxiv.org/abs/{{ entry.arxiv }}" target="_blank" rel="external noopener noreferrer">arXiv</a>
          {% endif %}
          {% if entry.html %}
            {% assign html_url = entry.html %}
            {% unless html_url contains '://' %}
              {% assign html_url = html_url | prepend: '/assets/html/' | relative_url %}
            {% endunless %}
            <a class="text-link" href="{{ html_url }}" target="_blank" rel="noopener noreferrer">HTML</a>
          {% endif %}
          {% if entry.pdf %}
            {% assign pdf_url = entry.pdf %}
            {% unless pdf_url contains '://' %}
              {% assign pdf_url = pdf_url | prepend: '/assets/pdf/' | relative_url %}
            {% endunless %}
            <a class="text-link" href="{{ pdf_url }}" target="_blank" rel="noopener noreferrer">PDF</a>
          {% endif %}
          {% if entry.supp %}
            {% assign supp_url = entry.supp %}
            {% unless supp_url contains '://' %}
              {% assign supp_url = supp_url | prepend: '/assets/pdf/' | relative_url %}
            {% endunless %}
            <a class="text-link" href="{{ supp_url }}" target="_blank" rel="noopener noreferrer">Supplement</a>
          {% endif %}
          {% if entry.video %}
            <a class="text-link" href="{{ entry.video }}" target="_blank" rel="external noopener noreferrer">Video</a>
          {% endif %}
          {% if entry.blog %}
            <a class="text-link" href="{{ entry.blog }}" target="_blank" rel="external noopener noreferrer">Blog</a>
          {% endif %}
          {% if entry.code %}
            <a class="text-link" href="{{ entry.code }}" target="_blank" rel="external noopener noreferrer">Code</a>
          {% endif %}
          {% if entry.poster %}
            {% assign poster_url = entry.poster %}
            {% unless poster_url contains '://' %}
              {% assign poster_url = poster_url | prepend: '/assets/pdf/' | relative_url %}
            {% endunless %}
            <a class="text-link" href="{{ poster_url }}" target="_blank" rel="noopener noreferrer">Poster</a>
          {% endif %}
          {% if entry.slides %}
            {% assign slides_url = entry.slides %}
            {% unless slides_url contains '://' %}
              {% assign slides_url = slides_url | prepend: '/assets/pdf/' | relative_url %}
            {% endunless %}
            <a class="text-link" href="{{ slides_url }}" target="_blank" rel="noopener noreferrer">Slides</a>
          {% endif %}
        </div>

        {% if entry.bibtex_show %}
          <details class="work-bibtex">
            <summary>BibTeX</summary>
            {% highlight bibtex %}
              {{- entry.bibtex | hideCustomBibtex -}}
            {% endhighlight %}
          </details>
        {% endif %}
      </div>
    </div>
  </div>
</article>
